rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Profiles
    match /profiles/{userId} {
      // Anyone can read profiles
      allow read: if isAuthenticated();
      // Only the user themselves can write/update their profile
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Tasks
    match /tasks/{taskId} {
      // Anyone can read tasks
      allow read: if isAuthenticated();

      // Creating tasks requires authentication and matching creator_id
      allow create: if isAuthenticated() && request.resource.data.creator_id == request.auth.uid;

      // Updating a task: creator can update everything; worker can claim or update status if assigned
      allow update: if isAuthenticated() && (
        resource.data.creator_id == request.auth.uid ||
        resource.data.assigned_to == request.auth.uid ||
        request.resource.data.assigned_to == request.auth.uid
      );

      // Deleting a task: only creator can delete
      allow delete: if isAuthenticated() && resource.data.creator_id == request.auth.uid;
    }

    // Task Applications
    match /task_applications/{appId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.applicant_id == request.auth.uid;
      allow update: if isAuthenticated(); // Both creator and applicant can update (e.g., status changes)
      allow delete: if isAuthenticated() && resource.data.applicant_id == request.auth.uid;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reviewer_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.reviewer_id == request.auth.uid;
    }

    // Achievements
    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated(); // Anyone can trigger a notification (e.g. system logic from client)
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
